# Copy to .env.voice and replace secrets. Never commit that file.
# These settings make NO cloud calls; speech + LiveKit bind locally.
VOICE_ENABLED=1
VOICE_API_URL=http://127.0.0.1:8765
VOICE_WORKER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
VOICE_STT_BASE_URL=http://127.0.0.1:8011/v1
VOICE_STT_MODEL=whisper-1
VOICE_TTS_BASE_URL=http://127.0.0.1:8011/v1
VOICE_TTS_MODEL=local
VOICE_SPEECH_HEALTH_URL=http://127.0.0.1:8011/health
# Owner is the selected voice. This requires the optional cloning environment.
VOICE_PROFILE=owner
VOICE_TTS_VOICE=owner
VOICE_TTS_DEVICE=cpu
VOICE_WHISPER_MODEL=tiny.en
VOICE_SPEECH_THREADS=2
# Explicit alternative for transport tests only:
# VOICE_PROFILE=demo
# VOICE_TTS_VOICE=demo
# PIPER_MODEL=/absolute/path/to/en_US-lessac-medium.onnx
